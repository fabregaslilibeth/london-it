# Copy to .env and fill in. Everything here ends up in the public site.

# Where the enquiry form sends its answers: a form service endpoint, e.g.
#   https://formspree.io/f/xxxxxxx   (Formspree)
#   https://api.web3forms.com/submit (Web3Forms — add your access key as a hidden field)
# Leave empty to open the visitor's email app with the answers filled in,
# addressed to the email on london-itsupport.co.uk.
VITE_FORM_ENDPOINT=
